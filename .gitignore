# احفظ هذا في .gitignore
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/
.pytest_cache/
.coverage
*.log

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
dist/

# Environment
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Uploads
backend/uploads/*
!backend/uploads/.gitkeep

# Database
*.db
*.sqlite3
"@ | Out-File -FilePath ".gitignore" -Encoding utf8